# Database
# Provide a PostgreSQL connection string that supports pgvector (e.g., Supabase, Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# Auth (NextAuth)
# Generate a secret using `openssl rand -base64 32` or similar
NEXTAUTH_SECRET="replace_me_with_a_random_string"
NEXTAUTH_URL="http://localhost:3000"

# Object Storage (S3-compatible)
# For storing raw PDF blobs
S3_BUCKET_NAME="my-pdf-bucket"
S3_REGION="us-east-1"
S3_ENDPOINT="https://s3.us-east-1.amazonaws.com" # Required if using Supabase Storage or R2, otherwise optional for AWS S3
AWS_ACCESS_KEY_ID="replace_me"
AWS_SECRET_ACCESS_KEY="replace_me"

# LLM Provider
# We use Google Gemini by default due to generous limits, but LangChain allows swapping.
# If you prefer OpenAI or Anthropic, provide their keys instead.
GOOGLE_API_KEY="replace_me"
# OPENAI_API_KEY="replace_me"
# ANTHROPIC_API_KEY="replace_me"
